{
  "name": "projectkoios-web",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:control": "vite --mode control",
    "build": "npm run build:public",
    "build:public": "tsc -b && vite build --mode public",
    "build:control": "tsc -b && vite build --mode control",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "start:www": "KOIOS_DEPLOYMENT_SURFACE=www ./scripts/startup.sh",
    "stop:www": "KOIOS_DEPLOYMENT_SURFACE=www ./scripts/shutdown.sh",
    "start:web": "KOIOS_DEPLOYMENT_SURFACE=web ./scripts/startup.sh",
    "stop:web": "KOIOS_DEPLOYMENT_SURFACE=web ./scripts/shutdown.sh",
    "start:local": "KOIOS_DEPLOYMENT_SURFACE=web ./scripts/startup.sh",
    "stop:local": "KOIOS_DEPLOYMENT_SURFACE=web ./scripts/shutdown.sh",
    "test": "vitest run && npm run test:startup",
    "test:startup": "bash tests/shell/startup-smoke.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "generate:api": "node scripts/generate-api.mjs",
    "generate:api:check": "node scripts/generate-api.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "katex": "^0.16.47",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
